
# Kasus 1: Absensi Kelas (Linear Search)
def cari_absensi(daftar, target):
    for i in range(len(daftar)):
        if daftar[i] == target:
            return i
    return -1
siswa = ["Budi", "Siti", "Rian", "Dewi"]
hasil1 = cari_absensi(siswa, "Rian")
print(f"Kasus 1: Rian ditemukan pada indeks ke-{hasil1}")


# Kasus 2
def cari_barang(tumpukan, target):
    low = 0
    high = len(tumpukan) - 1
    while low <= high:
        mid = (low + high) // 2
        if tumpukan[mid] == target:
            return mid
        elif tumpukan[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    return -1
barang = ["Botol Minum", "Dompet", "Kunci Motor", "Payung"]
hasil2 = cari_barang(barang, "Kunci Motor")
print(f"Kasus 2: Kunci Motor ditemukan pada indeks ke-{hasil2}")


