# Kasus 1
def cari_absensi(daftar, target):
    for i in range(len(daftar)):
        if daftar[i] == target:
            return f"Siswa bernama {target} ketemu di indeks {i}"
    return f"{target} nggak ada di absensi"

siswa = ["Budi", "Siti", "Rian", "Dewi"]
print(cari_absensi(siswa, "Rian"))


# Kasus 2
def cari_barang(tumpukan, target):
    low = 0
    high = len(tumpukan) - 1
    while low <= high:
        mid = (low + high) // 2
        if tumpukan[mid] == target:
            return f"Barang {target} ketemu di indeks {mid}"
        elif tumpukan[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    return f"{target} nggak ada di tumpukan"

barang = ["Botol Minum", "Dompet", "Kunci Motor", "Payung"]
print(cari_barang(barang, "Kunci Motor"))


